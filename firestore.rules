rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // MARYAM'S DESGINS — OFFICIAL DIGITAL VISITING CARD FIRESTORE SECURITY RULES
    // =========================================================================

    // 1. Settings & Profiles (Brand Bio, Phone, WhatsApp, Logo, Theme Palette)
    // - Public visitors can ONLY read visiting card details
    // - Authenticated admin strictly required for updating or modifying
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. Boutique Collection Catalog & Links
    // - Public visitors can ONLY view active collections
    // - Authenticated admin strictly required to add, update, reorder, or delete
    match /links/{linkId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. Multi-Brand Hub & Alternate Visiting Cards
    // - Public visitors can view specific brand cards (?brand=bridal, etc.)
    // - Authenticated admin strictly required to create and manage brands
    match /brands/{brandId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 4. Digital Visiting Card Analytics & Live Events
    // - Public visitors can record views, QR scans, and inquiry taps (create/update only)
    // - Resetting or deleting metrics strictly restricted to authenticated admin
    match /analytics/{document=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }
  }
}
